#!/bin/bash
# Fleet Verify - Auto-verification hook for Claude Code edits
# Receives JSON on stdin from Claude Code PostToolUse hook
# Checks: syntax, type errors, lint issues
#
# Output follows the Claude Code hook reference for PostToolUse:
#   - syntax errors are blocking feedback:
#       {"decision": "block", "reason": "..."}
#   - type and lint errors are non-blocking context for Claude:
#       {"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": "..."}}
# "block" is the only decision value Claude Code accepts. The hook always
# exits 0 and prints nothing when there is nothing to report.

# Tool output goes into Claude's context, so cap what one report can cost.
MAX_REPORT_CHARS=2000

# Both emitters build the JSON with jq, so quotes, backslashes and newlines in
# paths or tool output can never produce invalid JSON.
emit_block() {
  jq -cn --arg reason "${1:0:$MAX_REPORT_CHARS}" \
    '{decision: "block", reason: $reason}'
  exit 0
}

emit_context() {
  jq -cn --arg context "${1:0:$MAX_REPORT_CHARS}" \
    '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $context}}'
  exit 0
}

# Without jq the hook can neither read its input nor report anything.
command -v jq &>/dev/null || exit 0

INPUT=$(cat)
FILE=$(echo "$INPUT" | jq -r '.tool_input.file_path // empty')

if [ -z "$FILE" ] || [ ! -f "$FILE" ]; then
  exit 0
fi

# Detect project root by walking up to find package.json, requirements.txt, or pyproject.toml
detect_project() {
  local DIR="$1"
  while [ "$DIR" != "/" ]; do
    if [ -f "$DIR/package.json" ] || [ -f "$DIR/requirements.txt" ] || [ -f "$DIR/main.py" ] || [ -f "$DIR/pyproject.toml" ]; then
      echo "$DIR"
      return
    fi
    DIR=$(dirname "$DIR")
  done
}

PROJECT_DIR=$(detect_project "$(dirname "$FILE")")
EXT="${FILE##*.}"

if [ -z "$PROJECT_DIR" ]; then
  exit 0
fi

# ── Python files ──
if [ "$EXT" = "py" ]; then
  # Syntax check
  PYTHON=$(command -v python3 || command -v python) || exit 0
  if ! OUTPUT=$("$PYTHON" -m py_compile "$FILE" 2>&1); then
    emit_block "Python syntax error in $FILE: $OUTPUT"
  fi

  # Type check with pyright (if available, non-blocking — warn only)
  if command -v pyright &>/dev/null; then
    if ! TYPE_OUTPUT=$(cd "$PROJECT_DIR" && pyright "$FILE" 2>&1); then
      # Extract just the error count line
      ERROR_SUMMARY=$(echo "$TYPE_OUTPUT" | grep -E "error[s]?" | tail -1)
      emit_context "Type errors in $FILE: $ERROR_SUMMARY"
    fi
  fi

  exit 0
fi

# ── JS/JSX/TS/TSX files ──
if [[ "$EXT" =~ ^(js|jsx|ts|tsx)$ ]]; then
  # Syntax check for plain JS
  if [ "$EXT" = "js" ] && command -v node &>/dev/null; then
    if ! OUTPUT=$(node --check "$FILE" 2>&1); then
      emit_block "JS syntax error in $FILE: $OUTPUT"
    fi
  fi

  # Type check with tsc if tsconfig.json exists (non-blocking — warn only)
  if [[ "$EXT" =~ ^(ts|tsx)$ ]] && [ -f "$PROJECT_DIR/tsconfig.json" ]; then
    TYPE_OUTPUT=$(cd "$PROJECT_DIR" && npx tsc --noEmit --pretty false 2>&1 | grep -F "$FILE")
    if [ -n "$TYPE_OUTPUT" ]; then
      # Only report errors in the edited file, not the whole project
      ERROR_COUNT=$(echo "$TYPE_OUTPUT" | wc -l | tr -d ' ')
      FIRST_ERROR=$(echo "$TYPE_OUTPUT" | head -1)
      emit_context "$ERROR_COUNT type error(s) in $FILE: $FIRST_ERROR"
    fi
  fi

  # ESLint check if available (non-blocking — warn only)
  if [ -f "$PROJECT_DIR/.eslintrc.json" ] || [ -f "$PROJECT_DIR/.eslintrc.js" ] || [ -f "$PROJECT_DIR/.eslintrc.cjs" ] || [ -f "$PROJECT_DIR/eslint.config.js" ] || [ -f "$PROJECT_DIR/eslint.config.mjs" ]; then
    if [ -f "$PROJECT_DIR/node_modules/.bin/eslint" ]; then
      if ! LINT_OUTPUT=$(cd "$PROJECT_DIR" && npx eslint "$FILE" --no-warn-ignored --format compact 2>&1); then
        ERROR_COUNT=$(echo "$LINT_OUTPUT" | grep -c " Error -")
        if [ "$ERROR_COUNT" -gt 0 ]; then
          FIRST_ERROR=$(echo "$LINT_OUTPUT" | grep " Error -" | head -1)
          emit_context "$ERROR_COUNT lint error(s) in $FILE: $FIRST_ERROR"
        fi
      fi
    fi
  fi
fi

exit 0

