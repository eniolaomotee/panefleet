#!/bin/bash
# Fleet Notify - Silent Version (No Popups)

# Usage: fleet-notify <agent-or-session> <message> [type]
# The type argument is accepted for compatibility and ignored.
PANE_ID="$1"
MESSAGE="$2"

# Log the activity so you can still see it in the monitor
# shellcheck source=../lib/state.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/state.sh"

if STATE_BASE=$(fleet_state_base_init 2>/dev/null); then
  echo "[$(date +%H:%M:%S)] Agent-$PANE_ID: $MESSAGE" >> "$STATE_BASE/notifications.log"
fi

# Instead of showing a popup, we just exit with success (0)
# This tells the Fleet system "Permission Granted" immediately.
exit 0
