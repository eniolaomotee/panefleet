#!/bin/bash

# ==============================
# Fleet v6 – Grid Layout with Monitor + Agent Panes
# ==============================
# With no arguments this walks through an interactive menu. With any option
# it never prompts: flags answer the same questions the menu asks, and the
# rest take defaults. Run `fleet --help` for the list.

PARENT_DIR=$(pwd)

# shellcheck source=../lib/state.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/state.sh"

usage() {
  cat <<'USAGE'
Usage: fleet                 interactive menu
       fleet [options]       launch without prompts

Options:
  -n, --agents N       Number of agents (default 1). In phase mode, per phase.
  -r, --repo PATH      Directory the agents work in (default: current directory)
      --name NAME      Fleet name shown to other tools (default: directory name)
      --feature TEXT   Feature mode: every agent is briefed on this feature
      --plan FILE      Phase mode: brief agents from a markdown plan. Each
                       "### Phase ..." section becomes one group of agents.
      --phase TEXT     With --plan: only the phase whose heading contains TEXT.
                       Repeat for several phases. Default: every phase.
      --worktree NAME  Create git worktree ../wt-NAME on a new branch NAME
                       and run the agents there
      --no-attach      Create the session and print its name, do not attach
  -h, --help           Show this help

Examples:
  fleet --agents 3
  fleet --feature "CSV export" --agents 2 --repo ~/code/api
  fleet --plan docs/plan.md --phase "Phase 2" --no-attach
USAGE
}

die() {
  echo "fleet: $1" >&2
  echo "Try 'fleet --help'." >&2
  exit 2
}

# -------------------------------
# Options
# -------------------------------
INTERACTIVE=1
ATTACH=1
OPT_AGENTS=1
OPT_REPO="."
OPT_NAME=""
OPT_FEATURE=""
OPT_PLAN=""
OPT_PHASES=()
OPT_WORKTREE=""

if [ "$#" -gt 0 ]; then
  INTERACTIVE=0
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --no-attach)
      ATTACH=0
      shift
      continue
      ;;
    -n | --agents | -r | --repo | --name | --feature | --plan | --phase | --worktree)
      if [ "$#" -lt 2 ]; then
        die "option $1 needs a value"
      fi
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  case "$1" in
    -n | --agents) OPT_AGENTS="$2" ;;
    -r | --repo) OPT_REPO="$2" ;;
    --name) OPT_NAME="$2" ;;
    --feature) OPT_FEATURE="$2" ;;
    --plan) OPT_PLAN="$2" ;;
    --phase) OPT_PHASES+=("$2") ;;
    --worktree) OPT_WORKTREE="$2" ;;
  esac
  shift 2
done

# Validate everything the flags say before any tmux session exists, so a typo
# never leaves a half-built fleet behind.
if [ "$INTERACTIVE" = 0 ]; then
  if ! [[ "$OPT_AGENTS" =~ ^[1-9][0-9]*$ ]]; then
    die "--agents must be a positive number, got: $OPT_AGENTS"
  fi
  if [ ! -d "$OPT_REPO" ]; then
    die "--repo is not a directory: $OPT_REPO"
  fi
  OPT_REPO=$(cd "$OPT_REPO" && pwd)
  if [ -n "$OPT_PLAN" ] && [ -n "$OPT_FEATURE" ]; then
    die "--plan and --feature cannot be combined"
  fi
  if [ "${#OPT_PHASES[@]}" -gt 0 ] && [ -z "$OPT_PLAN" ]; then
    die "--phase needs --plan"
  fi
  if [ -n "$OPT_WORKTREE" ]; then
    if [ -n "$OPT_PLAN" ] || [ -n "$OPT_FEATURE" ]; then
      die "--worktree cannot be combined with --plan or --feature"
    fi
    if ! [[ "$OPT_WORKTREE" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
      die "--worktree is not a usable branch name: $OPT_WORKTREE"
    fi
  fi

  MODE=4
  if [ -n "$OPT_FEATURE" ]; then
    MODE=2
  fi
  if [ -n "$OPT_PLAN" ]; then
    MODE=1
    if [ ! -f "$OPT_PLAN" ]; then
      die "--plan is not a file: $OPT_PLAN"
    fi
    PLAN_FILE="$(cd "$(dirname "$OPT_PLAN")" && pwd)/$(basename "$OPT_PLAN")"
    ALL_PHASES=$(grep -E "^### Phase" "$PLAN_FILE")
    if [ -z "$ALL_PHASES" ]; then
      die "no '### Phase' headings found in $OPT_PLAN"
    fi
    if [ "${#OPT_PHASES[@]}" -eq 0 ]; then
      SELECTED_PHASES="$ALL_PHASES"
    else
      SELECTED_PHASES=""
      for WANTED in "${OPT_PHASES[@]}"; do
        MATCHES=$(grep -F -- "$WANTED" <<< "$ALL_PHASES")
        if [ -z "$MATCHES" ]; then
          die "--phase '$WANTED' matches no heading in $OPT_PLAN"
        fi
        if [ "$(wc -l <<< "$MATCHES" | tr -d ' ')" -gt 1 ]; then
          die "--phase '$WANTED' matches more than one heading in $OPT_PLAN"
        fi
        SELECTED_PHASES="${SELECTED_PHASES:+$SELECTED_PHASES$'\n'}$MATCHES"
      done
    fi
  fi
fi

# -------------------------------
# Check dependencies
# -------------------------------
# fzf and bat are only used by the menu's plan and phase pickers.
DEPS=(tmux git)
if [ "$INTERACTIVE" = 1 ]; then
  DEPS+=(fzf bat)
fi

for cmd in "${DEPS[@]}"; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "Missing dependency: $cmd"
    exit 1
  fi
done

if [ "$INTERACTIVE" = 1 ]; then

echo ""
echo "Select Fleet mode:"
echo "1) Phases (plan-based)"
echo "2) Custom Feature"
echo "3) Hybrid (Phases + Feature)"
echo "4) General Mode"
echo ""

read -r -p "Mode (1-4) > " MODE

# -------------------------------
# Helper: find git repos
# -------------------------------

REPOS=()

while IFS= read -r line
do
  REPOS+=("$line")
done < <(find . -maxdepth 2 -name ".git" -type d | sed 's|/.git||')

REPOS+=(".")

echo ""
echo "Select repo for Claude session:"
select repo in "${REPOS[@]}"
do
  if [ -n "$repo" ]; then
    break
  fi
done

REPO_PATH="$repo"

else
  REPO_PATH="$OPT_REPO"
fi

# -------------------------------
# Tmux session setup
# -------------------------------

FLEET_SESSION="fleet-$$"

# Fleet name: a human-readable label, saved in the state dir so other tools
# can tell fleets apart.
REPO_BASENAME=$(basename "$REPO_PATH")
if [ "$REPO_BASENAME" = "." ]; then
  REPO_BASENAME=$(basename "$PARENT_DIR")
fi
if [ "$INTERACTIVE" = 1 ]; then
  read -r -p "Fleet name [$REPO_BASENAME]: " FLEET_NAME
else
  FLEET_NAME="$OPT_NAME"
fi
FLEET_NAME="${FLEET_NAME:-$REPO_BASENAME}"

# Without a terminal (scripts, CI) tput has no size to report.
COLS=$(tput cols 2>/dev/null)
ROWS=$(tput lines 2>/dev/null)
[[ "$COLS" =~ ^[0-9]+$ ]] || COLS=200
[[ "$ROWS" =~ ^[0-9]+$ ]] || ROWS=50

tmux new-session -d -s "$FLEET_SESSION" -n "Fleet" -x "$COLS" -y "$ROWS"

# Private per-user state directory (mode 700). Clear out state from fleets
# that are no longer running, then create ours.
fleet_state_prune
if ! STATE_DIR=$(fleet_state_init "$FLEET_SESSION"); then
  tmux kill-session -t "$FLEET_SESSION" 2>/dev/null
  exit 1
fi

# Pane 0 = Monitor (left side, full height)

# -------------------------------
# Collect agent prompts, then build layout
# -------------------------------

AGENT_NAMES=()
AGENT_PROMPTS=()
AGENT_WORKDIRS=()

queue_agent () {
  local TITLE="$1"
  local PROMPT="$2"
  local WORKDIR="$3"
  AGENT_NAMES+=("$TITLE")
  AGENT_PROMPTS+=("$PROMPT")
  AGENT_WORKDIRS+=("$WORKDIR")
}

# -------------------------------
# Mode 1 – Phase Mode
# -------------------------------

if [ "$MODE" == "1" ]; then

if [ "$INTERACTIVE" = 1 ]; then

echo ""
echo "Searching for markdown plans..."

PLAN_FILE=$(find "$PARENT_DIR" -name "*.md" -not -path "*/node_modules/*" -not -path "*/.git/*" | fzf --height 50% --layout=reverse --border \
  --preview 'bat --style=numbers --color=always --theme=ansi {} | head -50' \
  --prompt="Select plan.md > ")

if [ -z "$PLAN_FILE" ]; then
  echo "No plan selected."
  tmux kill-session -t "$FLEET_SESSION" 2>/dev/null
  exit 1
fi

echo ""
echo "Extracting phases..."
echo "(Use TAB to select multiple phases, ENTER to confirm)"

SELECTED_PHASES=$(grep -E "^### Phase" "$PLAN_FILE" | fzf --multi --height 50% --layout=reverse --border \
  --preview-window=right:60%:wrap \
  --preview "LINE=\$(grep -nF {} \"$PLAN_FILE\" | head -1 | cut -d: -f1); END=\$(tail -n +\$((LINE+1)) \"$PLAN_FILE\" | grep -n '^### ' | head -1 | cut -d: -f1); if [ -n \"\$END\" ]; then sed -n \"\${LINE},\$((LINE+END-1))p\" \"$PLAN_FILE\" | bat --style=plain --color=always --theme=ansi -l md; else tail -n +\$LINE \"$PLAN_FILE\" | bat --style=plain --color=always --theme=ansi -l md; fi" \
  --prompt="Select phases (TAB=toggle) > ")

if [ -z "$SELECTED_PHASES" ]; then
  echo "No phases selected."
  tmux kill-session -t "$FLEET_SESSION" 2>/dev/null
  exit 1
fi

fi

AGENT_COUNTER=0

while IFS= read -r PHASE_NAME; do
  ESCAPED_PHASE=$(printf '%s\n' "$PHASE_NAME" | sed 's/[.[\(*^$+?{|]/\\&/g')
  PHASE_CONTEXT=$(awk "/$ESCAPED_PHASE/{flag=1;next}/^### Phase/{flag=0}flag" "$PLAN_FILE")

  echo ""
  echo "─── $PHASE_NAME ───"
  if [ "$INTERACTIVE" = 1 ]; then
    read -r -p "How many sessions for this phase? " COUNT </dev/tty
  else
    COUNT="$OPT_AGENTS"
  fi

  for ((i=1;i<=COUNT;i++)); do
    AGENT_COUNTER=$((AGENT_COUNTER + 1))

    PROMPT="You are an autonomous coding agent.

Context
-------
Workspace: $PARENT_DIR

Phase:
$PHASE_NAME

Instructions
------------
Only work on tasks in this phase.

Phase Plan
----------
$PHASE_CONTEXT

Source plan file:
$PLAN_FILE

Awaiting user instruction."

    SHORT_NAME="${PHASE_NAME#\#\#\# }"
    queue_agent "${SHORT_NAME}-A$i" "$PROMPT" "$REPO_PATH"
  done
done <<< "$SELECTED_PHASES"

fi

# -------------------------------
# Mode 2 – Feature Mode
# -------------------------------

if [ "$MODE" == "2" ]; then

if [ "$INTERACTIVE" = 1 ]; then
  echo ""
  read -r -p "Feature name: " FEATURE
else
  FEATURE="$OPT_FEATURE"
fi

PROMPT="You are an autonomous coding agent.

Workspace:
$PARENT_DIR

Feature:
$FEATURE

Awaiting user instruction."

if [ "$INTERACTIVE" = 1 ]; then
  read -r -p "How many Claude sessions? " COUNT
else
  COUNT="$OPT_AGENTS"
fi

for ((i=1;i<=COUNT;i++))
do
  queue_agent "Agent-$i" "$PROMPT" "$REPO_PATH"
done

fi

# -------------------------------
# Mode 3 – Hybrid Mode
# -------------------------------

if [ "$MODE" == "3" ]; then

echo ""
echo "Hybrid mode selected."

read -r -p "Feature name: " FEATURE

read -r -p "How many phase agents? " PHASE_COUNT
read -r -p "How many feature agents? " FEATURE_COUNT

PHASE_PROMPT="You are an autonomous coding agent.

Workspace:
$PARENT_DIR

Feature Context:
$FEATURE

Focus on the current phase tasks.

Awaiting user instruction."

FEATURE_PROMPT="You are an autonomous coding agent.

Workspace:
$PARENT_DIR

Feature:
$FEATURE

You may work across any required components.

Awaiting user instruction."

for ((i=1;i<=PHASE_COUNT;i++))
do
  queue_agent "Phase-$i" "$PHASE_PROMPT" "$REPO_PATH"
done

for ((i=1;i<=FEATURE_COUNT;i++))
do
  queue_agent "Feature-$i" "$FEATURE_PROMPT" "$REPO_PATH"
done

fi

# -------------------------------
# Mode 4 – General Mode
# -------------------------------

if [ "$MODE" == "4" ]; then

if [ "$INTERACTIVE" = 1 ]; then
  echo ""
  read -r -p "Optional branch/worktree? (y/n) " WORKTREE
  if [ "$WORKTREE" == "y" ]; then
    read -r -p "Branch name: " BRANCH
  fi
elif [ -n "$OPT_WORKTREE" ]; then
  WORKTREE="y"
  BRANCH="$OPT_WORKTREE"
fi

if [ "$WORKTREE" == "y" ]; then

  SAFE_BRANCH=$(echo "$BRANCH" | tr ' ' '-')
  # Slashes are fine in a branch name but not in the worktree directory name.
  WORKTREE_PATH="$REPO_PATH/../wt-${SAFE_BRANCH//\//-}"

  if ! git -C "$REPO_PATH" worktree add "$WORKTREE_PATH" -b "$SAFE_BRANCH"; then
    echo "fleet: could not create worktree $WORKTREE_PATH" >&2
    tmux kill-session -t "$FLEET_SESSION" 2>/dev/null
    fleet_state_remove "$FLEET_SESSION"
    exit 1
  fi

  REPO_PATH="$WORKTREE_PATH"

fi

if [ "$INTERACTIVE" = 1 ]; then
  read -r -p "How many Claude sessions to launch? " COUNT
else
  COUNT="$OPT_AGENTS"
fi

PROMPT="You are an autonomous coding agent.

Workspace:
$PARENT_DIR

General development session.

Awaiting user instruction."

for ((i=1;i<=COUNT;i++))
do
  queue_agent "Agent-$i" "$PROMPT" "$REPO_PATH"
done

fi

# -------------------------------
# Build grid layout: Monitor (left) | Agents stacked (right)
# -------------------------------

TOTAL_AGENTS=${#AGENT_NAMES[@]}

if [ "$TOTAL_AGENTS" -eq 0 ]; then
  echo "No agents to launch."
  tmux kill-session -t "$FLEET_SESSION" 2>/dev/null
  exit 1
fi

# Create agent panes by splitting from pane 0
for ((i=0;i<TOTAL_AGENTS;i++)); do
  tmux split-window -t "$FLEET_SESSION:0"
done

# Apply main-vertical layout: pane 0 = full-height left, rest stacked right
tmux select-layout -t "$FLEET_SESSION:0" main-vertical

# Set monitor (left pane) to 45% width
tmux resize-pane -t "$FLEET_SESSION:0.0" -x 45%

# Store pane names in files so they persist even when Claude overrides pane titles
NAME_DIR="$STATE_DIR/names"
echo "Control Center" > "$NAME_DIR/0"
echo "$FLEET_NAME" > "$STATE_DIR/name"

# Label and launch commands in each agent pane
for ((i=0;i<TOTAL_AGENTS;i++)); do
  PANE_IDX=$((i + 1))
  PROMPT_FILE="$STATE_DIR/prompt-${PANE_IDX}.txt"
  printf '%s' "${AGENT_PROMPTS[$i]}" > "$PROMPT_FILE"

  # Save pane name to file (immune to Claude overriding pane title)
  echo "${AGENT_NAMES[$i]}" > "$NAME_DIR/$PANE_IDX"

  # Log pane output to file for scrollback
  LOG_FILE="$STATE_DIR/agent-${PANE_IDX}.log"
  : > "$LOG_FILE"
  tmux pipe-pane -o -t "$FLEET_SESSION:0.${PANE_IDX}" "cat >> '$LOG_FILE'"

  # Launch claude in the pane
  tmux send-keys -t "$FLEET_SESSION:0.${PANE_IDX}" "cd '${AGENT_WORKDIRS[$i]}' && claude < '$PROMPT_FILE'; rm -f '$PROMPT_FILE'" Enter
done

# Enable mouse — click any pane to focus it
tmux set-option -t "$FLEET_SESSION" mouse on

# Enable pane titles with file-based lookup (Claude can't override these)
tmux set-option -t "$FLEET_SESSION" pane-border-status top
tmux set-option -t "$FLEET_SESSION" pane-border-format " #(cat '$NAME_DIR/#{pane_index}' 2>/dev/null || echo 'Pane #{pane_index}') "

# Launch relay in background inside tmux, then start monitor
tmux send-keys -t "$FLEET_SESSION:0.0" "fleet-relay '$FLEET_SESSION' &" Enter
sleep 1
tmux send-keys -t "$FLEET_SESSION:0.0" "fleet-monitor '$FLEET_SESSION'" Enter

# Focus on the monitor pane
tmux select-pane -t "$FLEET_SESSION:0.0"

if [ "$ATTACH" = 0 ]; then
  echo "$FLEET_SESSION"
  exit 0
fi

# Attach to session (switch-client when already inside tmux — attach refuses to nest)
if [ -n "$TMUX" ]; then
  tmux switch-client -t "$FLEET_SESSION"
else
  tmux attach -t "$FLEET_SESSION"
fi

